<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ir.jetvam</groupId>
    <artifactId>jetvam-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Jetvam Backend</name>
    <description>Jetvam modular-monolith LOS backend</description>

    <modules>
        <module>shared</module>
        <module>infrastructure</module>
        <module>modules</module>
        <module>apps</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <persian-date-time.version>4.2.1</persian-date-time.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal reactor modules -->
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-http-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-authorization-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-infra-i18n</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-otp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-settings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-origination</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-assessment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-guarantee</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-facility</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-merchant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-transaction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ir.jetvam</groupId>
                <artifactId>jetvam-module-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Third-party dependencies -->
            <dependency>
                <groupId>com.github.mfathi91</groupId>
                <artifactId>persian-date-time</artifactId>
                <version>${persian-date-time.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>verify-main-type-javadocs</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <resourcecount property="jetvam.main.java.count">
                                    <fileset dir="${maven.multiModuleProjectDirectory}">
                                        <include name="**/src/main/java/**/*.java"/>
                                    </fileset>
                                </resourcecount>
                                <resourcecount property="jetvam.main.java.author.count">
                                    <fileset dir="${maven.multiModuleProjectDirectory}">
                                        <include name="**/src/main/java/**/*.java"/>
                                        <containsregexp expression="@author reza jamshidi"/>
                                    </fileset>
                                </resourcecount>
                                <resourcecount property="jetvam.main.java.since.count">
                                    <fileset dir="${maven.multiModuleProjectDirectory}">
                                        <include name="**/src/main/java/**/*.java"/>
                                        <containsregexp expression="@since [0-9]+/[0-9]+/[0-9]+"/>
                                    </fileset>
                                </resourcecount>
                                <condition property="jetvam.main.java.javadocs.complete">
                                    <and>
                                        <equals arg1="${jetvam.main.java.count}"
                                                arg2="${jetvam.main.java.author.count}"/>
                                        <equals arg1="${jetvam.main.java.count}"
                                                arg2="${jetvam.main.java.since.count}"/>
                                    </and>
                                </condition>
                                <fail unless="jetvam.main.java.javadocs.complete"
                                      message="Every main Java type must include @author reza jamshidi and @since M/d/yyyy."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <doclint>all</doclint>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <failOnError>true</failOnError>
                    <show>protected</show>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
